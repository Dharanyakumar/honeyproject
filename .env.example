# Copy this file to .env (Hardhat reads it) and fill in the values.
# Never commit .env or share a private key that holds real funds. Use a test wallet.

# Hardhat: deploy to the Sepolia test network
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Python app: mirror ledger records to a deployed contract (optional).
# For a local node (npx hardhat node) use http://127.0.0.1:8545 and one of the
# private keys that `npx hardhat node` prints.
RPC_URL=http://127.0.0.1:8545
# PRIVATE_KEY is shared with the line above
# HONEY_DEPLOYMENT=deployments/localhost.json
